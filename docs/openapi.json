  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "error"
        ],
        "description": "Every failure: a kebab-case code a caller decides on, and an English sentence it decides nothing on."
      },
      "Health": {
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why it is not ready; null while it is."
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "ready",
          "version"
        ],
        "description": "Whether the service can answer, and its version."
      },
      "EventPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "more": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "more"
        ],
        "description": "One page of a list: its items, and whether anything stands past the last of them."
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "The event number, which only grows."
          },
          "kind": {
            "type": "string",
            "description": "`synthesis.created`, `synthesis.ended`, `transcription.ended` or `voice.changed`."
          },
          "at": {
            "type": "integer",
            "format": "int64",
            "description": "When it happened, in epoch milliseconds."
          },
          "data": {
            "description": "The member as a GET answers it."
          }
        },
        "required": [
          "id",
          "kind",
          "at",
          "data"
        ],
        "description": "One event of the service."
      },
      "VoicePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Voice"
            }
          },
          "more": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "more"
        ],
        "description": "One page of a list: its items, and whether anything stands past the last of them."
      },
      "Voice": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The voice's name, its key."
          },
          "language": {
            "type": "string",
            "description": "The language it speaks, as the language data names it."
          },
          "checkpoint": {
            "type": "string",
            "description": "The checkpoint its weights stand at."
          },
          "emotions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The emotions it may be asked to speak with."
          },
          "changedAt": {
            "type": "integer",
            "format": "int64",
            "description": "Epoch milliseconds of its last change."
          }
        },
        "required": [
          "name",
          "language",
          "checkpoint",
          "emotions",
          "changedAt"
        ],
        "description": "One trained voice."
      },
      "NewSynthesis": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voiceName": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "emotion": {
            "type": [
              "string",
              "null"
            ],
            "description": "One of the voice's emotions; the voice's own where absent.",
            "default": null
          },
          "style": {
            "type": [
              "string",
              "null"
            ],
            "description": "A delivery laid over the voice, where it names one.",
            "default": null
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "default": null
          }
        },
        "required": [
          "voiceName",
          "text"
        ],
        "description": "A text to speak."
      },
      "Synthesis": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "voiceName": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
