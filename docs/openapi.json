      "SynthesisState": {
        "oneOf": [
          {
            "type": "string",
            "const": "waiting",
            "description": "Taken in, not yet speaking."
          },
          {
            "type": "string",
            "const": "speaking",
            "description": "One voice server is speaking it."
          },
          {
            "type": "string",
            "const": "done",
            "description": "Its sound stands at `/syntheses/{synthesisId}/sound`."
          },
          {
            "type": "string",
            "const": "failed",
            "description": "It could not be spoken."
          }
        ],
        "description": "Where a synthesis stands in its life."
      },
      "NewTranscription": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "language": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "language",
          "files"
        ],
        "description": "Sound files to take down in one language."
      },
      "Transcription": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "language": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "description": "`waiting`, `running`, `done` or `failed`."
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "What was heard, the files in the order given; null until it is done."
          },
          "createdAt": {
            "type": "integer",
            "format": "int64",
            "description": "Epoch milliseconds."
          }
        },
        "required": [
          "id",
          "language",
          "state",
          "createdAt"
        ],
        "description": "One transcription."
      },
      "NewEncoding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fromWav": {
            "type": "string",
            "description": "The wav to encode."
          }
        },
        "required": [
          "fromWav"
        ],
        "description": "A reference recording to encode."
      },
      "Encoding": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "state": {
            "type": "string",
            "description": "`done` or `failed`."
          },
          "createdAt": {
            "type": "integer",
            "format": "int64",
            "description": "Epoch milliseconds."
          }
        },
        "required": [
          "id",
          "state",
          "createdAt"
        ],
        "description": "One speaker encoding."
      },
      "NewScriptReading": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "description": "The language the text is in; the voice's own where absent.",
            "default": null
          }
        },
        "required": [
          "text"
        ],
        "description": "A text read into a script for the ear."
      },
      "ScriptReading": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string"
          },
          "sentences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "script",
          "sentences"
        ],
        "description": "A text as a script for the ear: the whole of it, and its sentences."
      },
      "VoiceServerPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VoiceServer"
            }
          },
          "more": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "more"
        ],
        "description": "One page of a list: its items, and whether anything stands past the last of them."
      },
      "VoiceServer": {
        "type": "object",
        "properties": {
          "nodeName": {
            "type": "string",
            "description": "The node's name, its key."
          },
          "state": {
            "type": "string",
            "description": "`running` where the server answers, `absent` where the node does not."
          },
          "voiceNames": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The voices whose checkpoints the server holds loaded, in name order."
          }
        },
        "required": [
          "nodeName",
          "state",
          "voiceNames"
        ],
        "description": "One voice server on one node."
      }
    },
    "responses": {
      "Error": {
        "description": "A failure, in the common error shape.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The service's token, from the caller's own configuration."
      }
    }
  }
}
