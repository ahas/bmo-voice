{
  "openapi": "3.1.0",
  "info": {
    "title": "bmo-voice",
    "version": "0.1.0-rev.1",
    "description": "The voice engine: trained voices, speech synthesis on the voice servers of the nodes, transcription, speaker encodings and scripts for the ear. A synthesis is answered at once and the sound follows. Bodies are JSON with camelCase keys, times are integers of epoch milliseconds and spans of milliseconds end in Ms. A list is a page, `after` being the last member's name. Every failure is a non-2xx answer whose body is `code` and `error`. The harness plugin's tools, each a thin call of one route, are stated under `x-tools`. Speaking to listeners on a schedule is a caller's work and calls this engine; the briefings that did so are another service's."
  },
  "servers": [
    {
      "url": "/",
      "description": "the voice service"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "x-layer": "upstream",
  "x-stage": 4,
  "x-calls": [
    "arbiter"
  ],
  "x-harness": {
    "plugin": "ahas-voice",
    "mcp": "bmo-voice mcp",
    "entry": "A harness turns text into speech with voice_synthesize in a voice voice_voices lists, and reads the sound when voice_synthesis says it is done."
  },
