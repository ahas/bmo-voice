[Unit]
Description=bmo-script: the script studio's earlier unit, retired for bmo-voice-studio.service
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.local/share/bmo/data/env/voice.toml
# The studio's earlier unit holds its port until the deployment starts bmo-voice-studio.service, which stops this one
# on the way, so the new unit finds the port free.
Conflicts=bmo-voice-studio.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/bmo-voice/deploy
ExecStart=%h/.local/share/bmo-voice/deploy/bin/script-studio
Environment=BMO_VOICE_STUDIO_PORT=3214
Restart=on-failure
RestartSec=3
TimeoutStopSec=infinity

[Install]
WantedBy=default.target
# Stopped, disabled and unlinked once the voice service is up after the deployment.
X-BMO-Deploy=retire
