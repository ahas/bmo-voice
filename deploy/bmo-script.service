[Unit]
Description=bmo-script: the script studio (docs/script-studio.md in the voice's repository)
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.local/share/bmo/data/env/voice.toml

[Service]
# The studio runs out of the deploy tree: its binary in bin/, its settings in settings.toml, and the screen the
# deployment generated into studio/client/.output/public, which it serves by default. Its port is the one the proxy
# locations in deploy/nginx.conf pass to.
Type=simple
WorkingDirectory=%h/.local/share/bmo-voice/deploy
ExecStart=%h/.local/share/bmo-voice/deploy/bin/script-studio
Environment=BMO_SCRIPT_PORT=3214
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
# Restarted by every deployment just before the voice service, so it serves the release's screen.
X-BMO-Deploy=restart
